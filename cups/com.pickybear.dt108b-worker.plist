<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pickybear.dt108b-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Printers/DT108B/venv/bin/python3</string>
    <string>/Library/Printers/DT108B/dt108b_worker.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Library/Printers/DT108B</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Library/Logs/DT108BWorker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/DT108BWorker.stderr.log</string>
</dict>
</plist>
